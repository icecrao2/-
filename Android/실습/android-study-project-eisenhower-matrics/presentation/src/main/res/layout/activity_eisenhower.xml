<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".feature.eisenhower.EisenhowerActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/eisenhower_matrics_list_fragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/open_add_todo_button" />

    <androidx.fragment.app.FragmentContainerView
        android:visibility="gone"
        android:id="@+id/eisenhower_matrics_todo_form_fragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@id/open_add_todo_button"
        app:layout_constraintRight_toRightOf="parent" />

    <Button
        android:id="@+id/open_add_todo_button"
        android:layout_width="50dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/eisenhower_matrics_list_fragment"
        app:layout_constraintRight_toLeftOf="@+id/eisenhower_matrics_todo_form_fragment"
        android:text="+"
        android:textSize="32sp"
        android:textAlignment="center"
        android:padding="0dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>