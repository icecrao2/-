<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomeActivity">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/scanned_spiro_cal_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/cal_scan_button"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/scanned_spiro_kit_list"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/scanned_spiro_kit_list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/kit_scan_button"
        app:layout_constraintLeft_toRightOf="@id/scanned_spiro_cal_list"
        app:layout_constraintRight_toRightOf="parent"/>

    <Button
        android:id="@+id/cal_scan_button"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_margin="20dp"
        android:text="CAL SCAN"
        app:layout_constraintTop_toBottomOf="@id/scanned_spiro_kit_list"
        app:layout_constraintBottom_toTopOf="@id/cal_disconnect_button"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/kit_scan_button"/>

    <Button
        android:id="@+id/cal_disconnect_button"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_margin="20dp"
        android:text="CAL DISCONNECT"
        app:layout_constraintTop_toBottomOf="@id/cal_scan_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/kit_scan_button"/>

    <Button
        android:id="@+id/kit_scan_button"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_margin="20dp"
        android:text="KIT SCAN"
        app:layout_constraintTop_toBottomOf="@id/scanned_spiro_kit_list"
        app:layout_constraintBottom_toTopOf="@id/kit_off_button"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toRightOf="@id/cal_scan_button"/>

    <Button
        android:id="@+id/kit_off_button"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_margin="20dp"
        android:text="KIT OFF"
        app:layout_constraintTop_toBottomOf="@id/kit_scan_button"
        app:layout_constraintBottom_toTopOf="@id/kit_disconnect_button"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toRightOf="@id/cal_scan_button"/>

    <Button
        android:id="@+id/kit_disconnect_button"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_margin="20dp"
        android:text="KIT DISCONNECT"
        app:layout_constraintTop_toBottomOf="@id/kit_off_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toRightOf="@id/cal_scan_button"/>

</androidx.constraintlayout.widget.ConstraintLayout>